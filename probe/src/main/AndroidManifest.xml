<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 需求 B：Android 14+ 要求先跑一个 mediaProjection 类型的前台服务，才能 getMediaProjection()。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- dumpsys display 读 mFlags 用；需 adb 授予: pm grant io.github.ynkcc.moredisplay.probe android.permission.DUMP -->
    <uses-permission android:name="android.permission.DUMP" />

    <application
        android:allowBackup="false"
        android:label="MoreDisplay Probe"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.Light">

        <activity
            android:name=".ProbeActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".CaptureForegroundService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- 需求 C：无障碍手势探测服务（不被注入，仅用公开 API）。 -->
        <service
            android:name=".ProbeAccessibilityService"
            android:exported="false"
            android:label="MoreDisplay Probe A11y"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/probe_accessibility_service" />
        </service>
    </application>

</manifest>
