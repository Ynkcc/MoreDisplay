# Add project specific R8 rules here.
# AGP will combine all keep rule files in src/main/keepRules to pass to R8
#
# For more information, see the following:
#   https://d.android.com/r/tools/r8/keep-rules

# Shizuku UserService 在独立 shell 进程中以应用 APK 类加载器实例化，
# 保留入口类构造器与 Stub，避免裁剪/混淆破坏跨进程反射。
-keep class me.ynk.moredisplay.shizuku.DaemonUserService {
    public <init>(android.content.Context);
    public *;
}
-keep class me.ynk.moredisplay.shizuku.IDaemonRpc { *; }
-keep class me.ynk.moredisplay.shizuku.IDaemonRpc$* { *; }
-keep class me.ynk.moredisplay.core.** { *; }
-keep class me.ynk.moredisplay.daemon.** { *; }
-keep class me.ynk.moredisplay.dispatch.** { *; }
