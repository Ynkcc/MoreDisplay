# Add project specific R8 rules here.
# AGP will combine all keep rule files in src/main/keepRules to pass to R8
#
# For more information, see the following:
#   https://d.android.com/r/tools/r8/keep-rules

# Shizuku UserService 在独立 shell 进程中以应用 APK 类加载器实例化，
# 保留入口类构造器与 Stub，避免裁剪/混淆破坏跨进程反射。
# LibXposed API 102 模块入口：保留 XposedModule 子类与无参构造器
-keep,allowoptimization,allowobfuscation public class * extends io.github.libxposed.api.XposedModule {
    public <init>();
}
-dontwarn io.github.libxposed.annotation.**

-keep class io.github.ynkcc.moredisplay.shizuku.DaemonUserService {
    public <init>(android.content.Context);
    public *;
}
-keep class io.github.ynkcc.moredisplay.shizuku.IDaemonRpc { *; }
-keep class io.github.ynkcc.moredisplay.shizuku.IDaemonRpc$* { *; }
-keep class io.github.ynkcc.moredisplay.core.** { *; }
-keep class io.github.ynkcc.moredisplay.daemon.** { *; }
-keep class io.github.ynkcc.moredisplay.dispatch.** { *; }

# Xposed 模块入口由 LSPosed 按 META-INF/xposed/java_init.list 里的类名反射加载，
# dex 内不存在任何对它的引用，开启 R8 后会被整类误裁掉，必须显式保留。
# （这些类内部反射的是 framework 隐藏 API，framework 不在本 dex 中，不受影响。）
-keep class io.github.ynkcc.moredisplay.xposed.** { *; }
-keep class io.github.ynkcc.moredisplay.CommandActivity { *; }

# Shizuku 的 UserService 通过 Binder 跨进程调用，保留 aidl 生成的 Stub/Proxy。
-keep class **$Stub { *; }
-keep class **$Stub$Proxy { *; }
